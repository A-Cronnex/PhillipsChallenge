.expo/
.expo-shared/
.expo-dev-client/
android/
ios/

# Build outputs
/dist/
/build/
server/dist/
tileserver/dist/

# Self-hosted basemap build artifacts — produced by `npm run build-tiles`
# (tileserver/scripts/build-tiles.ts), not committed: Planetiler output and
# OpenFreeMap assets fetched at build time, not data this repository owns.
# `tileserver/styles/liberty.json` IS committed (small, refreshed by the same
# script) so `npm start` works without a fetch.
tileserver/data/
tileserver/assets/
tileserver/vendor/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files
.env
.env.*

# OS / editor files
.DS_Store
Thumbs.db

# Test coverage
coverage/

# Metro cache
.cache/

# Native build artifacts
*.keystore
*.jks

# QVAC generated worker and addon manifest (regenerated by prebuild)
qvac/
!.env.example
