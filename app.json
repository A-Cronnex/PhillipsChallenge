{
  "expo": {
    "name": "Hospital Equipment Intelligence",
    "slug": "hospital-equipment-intelligence",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "hei",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hei.app"
    },
    "android": {
      "package": "com.hei.app",
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "@maplibre/maplibre-react-native",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29,
            "useLegacyPackaging": true
          }
        }
      ],
      "@qvac/sdk/expo-plugin",
      [
        "expo-audio",
        {
          "microphonePermission": "Permite grabar tu descripción del equipo para transcribirla en este dispositivo.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "La aplicación usa tus fotos para leer la placa del equipo en el dispositivo, sin enviarlas a ningún servidor.",
          "cameraPermission": "La aplicación usa la cámara para fotografiar la placa del equipo. El análisis ocurre en el dispositivo."
        }
      ]
    ]
  }
}
